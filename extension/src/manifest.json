{
  "manifest_version": 3,
  "name": "Yandex Marketing Bridge — ChatGPT ↔ Yandex",
  "version": "0.1.0",
  "description": "Единый контролируемый мост ChatGPT ↔ Yandex Marketing APIs. Phase 1: Wordstat + unified CORE, Job/Run, policy and cost guards.",
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://searchapi.api.cloud.yandex.net/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "shared/product.js",
        "shared/conversation_identity.js",
        "shared/service_registry.js",
        "shared/wordstat_protocol.js",
        "shared/autorun_model.js",
        "shared/manual_controls.js",
        "shared/composer_send.js",
        "shared/proven_writing_block_capture.js",
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Yandex Marketing Bridge",
    "default_popup": "popup.html"
  }
}
