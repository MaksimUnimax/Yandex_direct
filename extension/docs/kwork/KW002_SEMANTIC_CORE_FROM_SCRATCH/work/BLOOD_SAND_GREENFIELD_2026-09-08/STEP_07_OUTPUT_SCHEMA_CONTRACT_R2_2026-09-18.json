            "AUDIT_ONLY_ALREADY_PRESENT",
            "AUDIT_ONLY_DUPLICATE",
            "EXCLUDED_OUT_OF_SCOPE",
            "HOLD_AMBIGUOUS"
          ]
        },
        {
          "name": "notes",
          "type": "string",
          "required": true,
          "fallback": "NONE"
        }
      ]
    },
    {
