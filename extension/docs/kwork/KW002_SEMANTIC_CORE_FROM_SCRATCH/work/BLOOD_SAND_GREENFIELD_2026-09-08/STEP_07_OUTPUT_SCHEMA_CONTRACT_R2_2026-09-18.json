        {
          "name": "ranking_query_unique_query_count",
          "type": "integer",
          "required": true,
          "minimum": 0
        },
        {
          "name": "ranking_query_candidate_count",
          "type": "integer",
          "required": true,
          "minimum": 0
        },
        {
          "name": "limitation_reason",
          "type": "string",
          "required": true,
          "fallback": "NONE"
        },
        {
          "name": "overall_step07_discovery_status",
          "type": "enum",
          "required": true,
          "allowed": [
            "COMPLETE",
            "COMPLETE_WITH_INACCESSIBLE_EVIDENCE",
            "INCOMPLETE_REQUIRED_RANKING_QUERY_LANE",
