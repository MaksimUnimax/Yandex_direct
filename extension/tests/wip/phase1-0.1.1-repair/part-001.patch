+async function importSettingsFile(file) {
+  if (!file) throw new Error("Файл backup не выбран.");
+  if (file.size > 5 * 1024 * 1024) throw new Error("Backup слишком большой.");
+  const text = await file.text();
+  let backup;
+  try { backup = JSON.parse(text); }
+  catch (_) { throw new Error("Backup не является валидным JSON."); }
+  const response = await send("WS_IMPORT_SETTINGS", { backup });
+  if (!response.ok) throw Object.assign(new Error(response.error || "Import settings не выполнен."), { code: response.code });
+  return response;
+}
